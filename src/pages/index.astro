const heroCups = products.filter((p) => ["athlet", "recover", "pregame"].includes(p.key));

// Per-product accent custom properties, emitted as one inline stylesheet
// instead of style="" attributes so the strict CSP (astro.config.mjs
// `experimental.csp`, no 'unsafe-inline') can allow it via a single hash.
// The extra [data-*] / descendant selectors outrank the base rules in
// global.css, matching the old inline-style precedence.
const productPalette = products
  .map(
    (product) =>
      `.product-card.${product.key} .product-visual{--visual-bg:${product.visualBg};}` +
      `.sample-card.${product.key}[data-sample-card]{--sample-color:${product.cup.accent};}`,
  )
  .join("");
Astro.csp.insertStyleHash(`sha256-${createHash("sha256").update(productPalette).digest("base64")}`);
---

<Base
  title="AthletO · Hydration you can eat"
  description="AthletO is an early cold-prep, spoonable hydration and recovery concept: choose a light gel or creamy pudding, then choose an everyday or recovery moment."
>
  <style is:inline set:html={productPalette}></style>
  <main class="jello-page">
    <section class="jello-hero" aria-labelledby="jello-title">
      <div class="hero-copy">
        <a class="brand-lockup" href="/" aria-label="AthletO home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 64 64" role="presentation" focusable="false">
              <path d="M13 42c0-15 8-29 19-29s19 14 19 29c0 9-7 14-19 14S13 51 13 42Z" fill="#53d86a" stroke="#12323a" stroke-width="4"/>
              <path d="M24 36c0-6 3-12 8-12s8 6 8 12-3 9-8 9-8-3-8-9Z" fill="#f8fbff" stroke="#12323a" stroke-width="4"/>
              <path d="M20 15c4 6 20 6 24 0" fill="none" stroke="#12323a" stroke-width="4" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="brand-name wordmark">Athlet<span class="o">O</span></span>
        </a>
        <p class="eyebrow">Cold-prep spoonable concepts</p>
        <h1 id="jello-title">Hydration you can eat.</h1>
        <p class="lede">One step over from enhanced water. One step back from overnight breakfast. AthletO is exploring portioned gels and puddings designed around an evening prep, an overnight chill, and an active tomorrow.</p>
        <div class="hero-actions" aria-label="AthletO page links">
          <a href="#category">See where it fits</a>
          <a href="#products">Explore the concept lab</a>
        </div>
      </div>
      <div class="hero-stage" aria-label="AthletO product lineup">
        <div class="shelf">
          {heroCups.map((product) => (
            <div class="hero-pack" aria-hidden="true">
              <CupVisual sub={product.sub} cup={product.cup} uid={`hero-${product.key}`} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="jello-section category-band" id="category" aria-labelledby="category-title">
      <div class="section-heading">
        <p class="eyebrow">Keep the choice small</p>
        <h2 id="category-title">Two decisions define the product.</h2>
        <p>The first launch should not ask shoppers to decode ten supplement stacks. It should ask two familiar questions: what texture sounds good, and when do you want it?</p>
      </div>
      <div class="choice-grid" aria-label="AthletO product choices">
        <article>
          <span>01 · Texture</span>
          <h3>Light gel or creamy pudding?</h3>
          <p>Choose a clean wobble closer to a drink, or a richer spoonful closer to an overnight snack.</p>
        </article>
        <article>
          <span>02 · Moment</span>
          <h3>Everyday or recovery?</h3>
          <p>Choose the routine: a lighter daily hydration brief or a more substantial post-training brief.</p>
        </article>
      </div>
      <div class="category-map" aria-label="Adjacent product category comparison">
        <article><span>Enhanced water</span><b>Open · sip</b><p>Ready to drink, familiar, and portable.</p></article>
        <article><span>Water enhancer</span><b>Squeeze · mix · sip</b><p>Compact flavor and functional customization.</p></article>
        <article><span>Overnight oats or pudding</span><b>Prep · chill · spoon</b><p>A planned, satisfying fridge ritual.</p></article>
        <article class="athleto-lane"><span>AthletO concept</span><b>Portion · chill · spoon</b><p>A water-adjacent gel or pudding for an active routine.</p></article>
      </div>
      <p class="research-note">The overnight cold-prep method is a design target. Final directions—including whether heat is required—depend on formulation and food-safety validation.</p>
    </section>

    <section class="jello-section" id="products" aria-labelledby="products-title">
      <div class="section-heading">
        <p class="eyebrow">Concept lab</p>
        <h2 id="products-title">Ten briefs, not ten launch promises.</h2>
        <p>These cards are directions for formulation and tasting. The launch range should come from the two-choice system above; nutrition, claims, ingredients, texture, preparation, and availability remain subject to validation.</p>
      </div>
      <div class="product-line">
        {products.map((product) => (
          <article class={`product-card ${product.key}`}>
            <div class="product-visual" aria-hidden="true">
              <span class="cal-chip">{product.calories} cal target</span>
              <CupVisual sub={product.sub} cup={product.cup} uid={`card-${product.key}`} />
              <PacketVisual sub={product.sub} body={product.cup.body} accent={product.cup.accent} uid={`card-${product.key}`} />
            </div>
            <div class="product-copy">
              <p class="product-kicker">{product.kicker}</p>
              <h3 class="product-name">
                <span class="wordmark">Athlet<span class="o">O</span></span>
                <span class="product-sub">{product.sub}</span>
              </h3>
              <p class="tagline">{product.tagline}</p>
              <div class="format-row" aria-label={`AthletO ${product.sub} concept formats`}>
                <div class="format">
                  <b>Chilled cup</b>
                  <span>A prepared, portioned concept for the fridge and cooler.</span>
                  <span class="format-cal">{product.calories} cal target</span>
                </div>
                <div class="format">
                  <b>Overnight mix</b>
                  <span>An evening-prep concept; final directions follow bench testing.</span>
                  <span class="format-cal">{product.calories} cal target</span>
                </div>
              </div>
              <ul class="benefits" aria-label={`AthletO ${product.sub} formulation targets`}>
                {product.benefits.map((benefit) => (
                  <li>{benefit}</li>
                ))}
              </ul>
              <div class="ingredients">
                <p class="ingredients-title">Prototype ingredient brief</p>
                <p class="ingredients-list">{product.ingredients.join(", ")}. <b>Zero-added-sugar direction.</b></p>
              </div>
              <p class="concept-state">Concept only · Not yet for sale</p>
            </div>
          </article>
        ))}
      </div>
      <p class="store-note">Nothing on this page is a final nutrition label, health claim, preparation instruction, or offer for sale.</p>
    </section>

    <section class="jello-section sweetener-band" aria-labelledby="sweetener-title">
      <div>
        <h2 id="sweetener-title">A zero-added-sugar direction.</h2>
        <p>The current formulation brief explores stevia leaf extract and erythritol rather than added sugar. Sweetener system, tolerability, flavor, nutrition facts, and any final label language will be decided through formulation and regulatory review.</p>
      </div>
      <div class="sweetener-chips" aria-label="Sweetener facts">
        <span>Stevia leaf extract</span>
        <span>Erythritol</span>
        <span>0g added sugar target</span>
        <span>Flavor testing required</span>
        <span>Final label pending</span>
      </div>
    </section>

    <section class="jello-section sampler-band" aria-labelledby="sampler-title">
      <div class="sampler-copy">
        <h2 id="sampler-title">Build a concept tasting brief.</h2>
        <p>Pick a direction to see how flavor, texture, and function could come together for a future test batch.</p>
      </div>
      <div class="sampler-panel">
        <div class="sampler-controls" aria-label="Sample pack choices">
          {products.map((product, index) => (
            <button type="button" data-sample={product.key} aria-pressed={index === 0 ? "true" : "false"}>{product.sub}</button>
          ))}
        </div>
        <div id="sampler-result" class="sampler-result" aria-live="polite">
          {products.map((product, index) => (
            <div class={`sample-card ${product.key}`} data-sample-card={product.key} hidden={index !== 0}>
              <div class="sample-badge">{product.badge}</div>
              <div>
                <p class="sample-sub">Athlet<span class="o-inline">O</span> · {product.sub}</p>
                <h3>{product.sampleTitle}</h3>
                <p>{product.sampleCopy}</p>
                <div class="sample-stack">
                  {product.benefits.slice(0, 4).map((chip) => (
                    <span>{chip}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="jello-section formula-band" id="formula" aria-labelledby="formula-title">
      <div>
        <h2 id="formula-title">A water-adjacent idea with a spoon.</h2>
        <p>Enhanced water proves the functional-drink habit. Water enhancers prove compact customization. Overnight foods prove people will prep, chill, and spoon. AthletO combines those behaviors into a formulation question worth testing.</p>
      </div>
      <div class="formula-grid">
        <div class="formula-tile"><b>Texture first</b><span>Bench-test a light gel and a creamy pudding before multiplying flavors or functions.</span></div>
        <div class="formula-tile"><b>Protein with context</b><span>Gelatin is incomplete protein; any recovery positioning needs a validated amino-acid and nutrition strategy.</span></div>
        <div class="formula-tile"><b>Digestive tolerance</b><span>Fiber, cultures, and sugar alcohols require sensory, stability, and tolerance testing at the intended serving size.</span></div>
        <div class="formula-tile"><b>Hydration math</b><span>Sodium, potassium, magnesium, water volume, and serving occasion must be set together—not as badge copy.</span></div>
        <div class="formula-tile"><b>Cold-prep reality</b><span>Set, shelf life, food safety, and final preparation directions must work in an actual home fridge.</span></div>
        <div class="formula-tile"><b>Claims come last</b><span>Final copy follows the tested formula, nutrition analysis, applicable regulation, and evidence.</span></div>
      </div>
    </section>
  </main>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-sample]");
    const cards = document.querySelectorAll<HTMLElement>("[data-sample-card]");
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const selected = button.dataset.sample;
        for (const other of buttons) {
          other.setAttribute("aria-pressed", String(other === button));
        }
        for (const card of cards) {
          card.hidden = card.dataset.sampleCard !== selected;
        }
      });
    }
  </script>
</Base>
